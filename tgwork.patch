diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/VibrationSettings.java b/TMessagesProj/src/main/java/org/telegram/messenger/VibrationSettings.java
new file mode 100644
index 0000000..64af276
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/VibrationSettings.java
@@ -0,0 +1,24 @@
+package org.telegram.messenger;
+
+import android.content.SharedPreferences;
+
+/** Глобальный переключатель вибрации/хаптика внутри приложения. */
+public class VibrationSettings {
+    private static final String KEY = "tgwork_vibration_enabled";
+    private static volatile Boolean cached;
+
+    public static boolean isEnabled() {
+        Boolean c = cached;
+        if (c == null) {
+            SharedPreferences p = MessagesController.getGlobalMainSettings();
+            c = p.getBoolean(KEY, true);
+            cached = c;
+        }
+        return c;
+    }
+
+    public static void setEnabled(boolean enabled) {
+        cached = enabled;
+        MessagesController.getGlobalMainSettings().edit().putBoolean(KEY, enabled).apply();
+    }
+}
